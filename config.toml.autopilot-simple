default_phase = "coding"
model_selection_mode = "adaptive"

[runtime]
maintenance_interval_seconds = 60
health_interval_seconds = 120
shutdown_drain_seconds = 30
sqlite_vacuum_interval_cycles = 60

[agents.copilot]
type = "copilot"
url = "http://127.0.0.1:8080"

[flow]
name = "Autopilot Simple"
phases = ["coding"]

[phases.coding]
description = "Simple autopilot coding phase"
agents = ["copilot"]
fallback = false
principles = [
    "Make the smallest correct change",
    "Do not claim done without build or test proof"
]

[phases.coding.options]
autopilot_complexity = "simple"
request_timeout_seconds = 120
cache_enabled = false
vector_enabled = false
