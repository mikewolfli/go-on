# ========================================================================
# ACP Flow Proxy Configuration - AUTOPILOT SIMPLE MODE
# ========================================================================
# This configuration is optimized for SIMPLE AUTOPILOT mode:
# - Fast 2-3 step workflows
# - Single AI per step (minimal overhead)
# - Suitable for: bug fixes, refactoring, documentation
# - Chat mode: full_auto with autopilot_complexity = "simple"
# - Approval strategy: AutoPilotSimple (fully automated, no dual review)
# - No dedicated review phase is defined; ask-mode requests fall back to default_phase
# ========================================================================

# Default phase (used when request does not provide phase)
default_phase = "coding"

[cache]
enabled = true
path = "acp_cache.sqlite3"
default_ttl_seconds = 3600
max_entries = 5000

[vector]
enabled = true
auto_mode = true
path = "acp_vector.sqlite3"
dimensions = 192
min_query_chars = 80
top_k = 2
min_similarity = 0.82
max_snippet_chars = 800
max_entries = 10000
summary_enabled = true
summary_trigger_messages = 8
summary_max_chars = 1200

[autotune]
# Runtime autotune persists state locally and adjusts vector thresholds over time.
enabled = true
evaluate_interval = 20
min_query_chars_step = 20
min_query_chars_min = 40
min_query_chars_max = 300
max_top_k = 4
low_precision_threshold = 0.35
high_precision_threshold = 0.75
state_path = "acp_autotune_state.json"
cooldown_windows = 2
min_vector_searches = 5
summary_trigger_min = 3
summary_trigger_max = 20

# Define all agents (models)
[agents.copilot]
type = "copilot"
url = "http://127.0.0.1:8080"

[agents.deepseek]
type = "deepseek"
api_key_env = "DEEPSEEK_API_KEY"
model = "deepseek-chat"

[agents.wenxin]
type = "wenxin"
api_key_env = "WENXIN_API_KEY"
secret_key_env = "WENXIN_SECRET_KEY"

# Generic OpenAI-compatible provider example (optional)
#[agents.other_provider]
#type = "openai_compatible"
#url = "https://api.openai.com"
#api_key_env = "OTHER_PROVIDER_API_KEY"
#model = "gpt-4o-mini"
#supports_system = true

# Define flow
[flow]
name = "Simple Autopilot Flow"
phases = ["coding"]

# ========================================================================
# CODING PHASE (Simple Autopilot)
# Single agent, fast completion, minimal overhead
# ========================================================================
[phases.coding]
description = "Coding phase (simple autopilot mode)"
agents = ["copilot"]  # Single agent for fast execution
fallback = false      # No fallback in simple mode
principles = [
    "Use meaningful variable names; avoid abbreviations",
    "Each function should be no more than 50 lines and follow single responsibility",
    "Prefer the standard library; avoid reinventing the wheel",
    "All public functions must include doc comments"
]

[phases.coding.options]
max_history_messages = 15
# SIMPLE MODE: Single-step, single AI execution
autopilot_complexity = "simple"
max_history_chars = 8000
request_timeout_seconds = 90
cache_enabled = true
cache_ttl_seconds = 1200
vector_enabled = true
vector_auto = true
vector_min_query_chars = 80
vector_top_k = 2
vector_min_similarity = 0.82
vector_max_snippet_chars = 800
summary_enabled = true
summary_trigger_messages = 6
summary_max_chars = 1000
