# ════════════════════════════════════════════════════════════════
# go-on Kubernetes Secrets (template)
# ════════════════════════════════════════════════════════════════
# Copy this file to .secrets.local.env and fill in real values:
#   cp .secrets.env .secrets.local.env
#   # then edit .secrets.local.env with actual secrets
#
# kustomization.yaml references .secrets.local.env (gitignored).
# WARNING: Never commit real secrets to version control!
# ════════════════════════════════════════════════════════════════
#
# After populating .secrets.local.env with real values, create the
# Kubernetes Secret from the env file:
#
#   kubectl create secret generic go-on-secrets \
#     --from-env-file=.secrets.local.env
#
# Or apply via Kustomize (recommended):
#
#   kustomize build deploy/k8s/ | kubectl apply -f -
#
# ════════════════════════════════════════════════════════════════
#
# 🚨 DEPLOYMENT GUARD:
#   Run this before deploying to verify no placeholder values remain:
#     grep -q 'placeholder\|change-me' .secrets.local.env \
#       && echo "ERROR: Placeholder secrets detected!" \
#       && exit 1
#
# ════════════════════════════════════════════════════════════════

# ── DeepSeek API key ───────────────────────────────────────────
# Generate a DeepSeek API key at: https://platform.deepseek.com/api_keys
# Required for LLM inference when using the deepseek model provider.
# Example: GO_ON_DEEPSEEK_API_KEY=sk-abc123def456ghi789jkl
GO_ON_DEEPSEEK_API_KEY=sk-placeholder

# ── Server API key ─────────────────────────────────────────────
# Generate a random 32+ character secret for inter-service auth.
# You can generate one with:
#   openssl rand -hex 32
# Or:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Example: server-api-key=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b
server-api-key=change-me-to-a-random-secret
