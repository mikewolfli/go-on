[Unit]
Description=go-on Simple Server (ACP proxy with flow, phases and multi-agent routing)
Documentation=https://github.com/mikewolfli/go-on
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=go-on
Group=go-on
WorkingDirectory=/opt/go-on/backend

Environment="RUST_LOG=warn"
Environment="GO_ON_SERVER_API_KEY=change-me-to-a-random-secret"
# Environment="DEEPSEEK_API_KEY=sk-xxxxx"

ExecStart=/opt/go-on/backend/go-on \
    -c /opt/go-on/backend/config.toml \
    --mode acp_http \
    --bind 127.0.0.1:8090

StandardOutput=append:/opt/go-on/backend/backend.log
StandardError=append:/opt/go-on/backend/backend.log

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
