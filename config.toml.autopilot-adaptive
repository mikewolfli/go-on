# [protocol] 配置说明
# auto: 自动识别（推荐，兼容Zed external agent和MCP LLM provider）
# acp: 仅支持ACP/A2A协议（Zed external agent专用）
# mcp: 仅支持MCP协议（MCP工具链/大模型服务专用）
[protocol]
mode = "auto"
default_phase = "coding"
model_selection_mode = "adaptive"

# Setup guidance:
# - Run `go-on --setup --config config.toml` to choose providers interactively.
# - Run `go-on --status --config config.toml` to inspect configured AI readiness.

[cache]
enabled = true
path = "acp_cache.sqlite3"
default_ttl_seconds = 3600
max_entries = 5000

[vector]
enabled = true
auto_mode = true
path = "acp_vector.sqlite3"
dimensions = 192
min_query_chars = 80
top_k = 2
min_similarity = 0.82
max_snippet_chars = 800
max_entries = 10000
summary_enabled = true
summary_trigger_messages = 8
summary_max_chars = 1200

[runtime]
maintenance_interval_seconds = 60
health_interval_seconds = 120
shutdown_drain_seconds = 30
sqlite_vacuum_interval_cycles = 60
# acp_http_bind_addr = "127.0.0.1:8090"   # Uncomment to enable REST/SSE
otel_enabled = false
otel_exporter = "otlp"
# otel_endpoint = "http://localhost:4317"   # Uncomment for Jaeger/OTLP
otel_service_name = "go-on"
otel_sample_ratio = 1.0
trace_slow_top_n = 20

[autotune]
enabled = false
evaluate_interval = 20
min_query_chars_step = 20
min_query_chars_min = 40
min_query_chars_max = 300
max_top_k = 4
low_precision_threshold = 0.35
high_precision_threshold = 0.75
state_path = "acp_autotune_state.json"
cooldown_windows = 2
min_vector_searches = 5
summary_trigger_min = 3
summary_trigger_max = 20

[agents.primary]
# type 可选: openai | deepseek | claude | gemini | qwen | 其他支持的provider
type = "openai"
url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
model = "gpt-4o-mini"
# api_key_env can also reference keyring, for example:
# api_key_env = "keyring://go-on/openai_compatible_api_key"

[flow]
name = "Autopilot Adaptive"
phases = ["planning", "coding", "review", "delivery"]

[phases.planning]
description = "Planning phase"
agents = ["primary"]
fallback = true

[phases.coding]
description = "Coding phase"
agents = ["primary"]
fallback = true

[phases.coding.options]
autopilot_complexity = "auto"
request_timeout_seconds = 150
review_timeout_seconds = 60
cache_enabled = true
vector_enabled = true
summary_enabled = true
full_auto_review_agents = ["primary"]
review_gate_timeout_seconds = 90
phase_max_inflight = 24
global_max_inflight = 128

[phases.review]
description = "Review phase"
agents = ["primary"]
fallback = true

[phases.review.options]
request_timeout_seconds = 60
review_gate_timeout_seconds = 90
review_timeout_policy = "reject"
review_min_response_chars = 12
phase_max_inflight = 16
global_max_inflight = 128

[phases.delivery]
description = "Delivery phase"
agents = ["primary"]
fallback = false
