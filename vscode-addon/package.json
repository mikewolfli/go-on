    "configuration": {
      "title": "Go-On",
      "properties": {
        "go-on.configPath": {
          "type": "string",
          "default": "./config.toml",
          "description": "Path to the Go-On config file"
        },
        "go-on.executablePath": {
          "type": "string",
          "default": "./target/release/go-on",
          "description": "Path to the Go-On executable"
        },
        "go-on.autoDownloadBinary": {
          "type": "boolean",
          "default": false,
          "description": "Automatically download Go-On runtime from GitHub releases when executablePath does not exist (disabled by default)"
        },
        "go-on.releaseRepository": {
          "type": "string",
          "default": "mikewolfli/go-on",
          "description": "GitHub repository used for downloading runtime assets (owner/repo)"
        },
        "go-on.releaseTag": {
          "type": "string",
          "default": "latest",
          "description": "Release tag to download from (for example v0.4.6). Use latest for newest release"
        },
        "go-on.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start Go-On when workspace opens"
        },
        "go-on.autoOpenChat": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Chat panel on first activation (may steal focus)"
        },
        "go-on.runtime.protocolMode": {
          "type": "string",
          "default": "from_config",
          "enum": [
            "from_config",
            "adaptive",
            "acp_stdio",
            "acp_http",
            "mcp_stdio",
            "mcp_http"
          ],
          "enumDescriptions": [
            "Use [protocol].mode from config.toml",
            "Adaptive access mode",
            "Force ACP over STDIO",
            "Force ACP over HTTP",
            "Force MCP over STDIO",
            "Force MCP over HTTP"
          ],
          "description": "Runtime startup protocol mode override passed as --protocol-mode"
        },
        "go-on.chat.maxHistory": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of chat messages to keep in history"
        },
        "go-on.chat.model": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "copilot",
            "deepseek",
            "wenxin",
            "openai",
            "doubao",
            "anthropic",
            "gemini",
            "groq",
            "mistral",
            "minimax",
            "glm",
            "yi",
            "moonshot",
            "qianfan",
            "qwen",
            "hunyuan"
          ],
          "enumDescriptions": [
            "Automatically select based on configuration",
            "GitHub Copilot (local)",
            "DeepSeek",
            "Wenxin / ERNIE-Bot",
            "OpenAI (GPT-4o etc)",
            "Doubao (ByteDance)",
            "Anthropic Claude",
            "Google Gemini",
            "Groq (fast inference)",
            "Mistral AI",
            "MiniMax",
            "Zhipu GLM",
            "01.AI Yi",
            "Moonshot Kimi",
            "Baidu Qianfan",
            "Alibaba Qwen",
            "Tencent Hunyuan"
          ],
          "description": "Default AI model/provider to use for chat"
        },
        "go-on.chat.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for chat responses (0.0 = deterministic, 2.0 = very random)"
        },
        "go-on.chat.maxTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 1,
          "maximum": 32768,
          "description": "Maximum tokens for chat responses"
        },
        "go-on.chat.streaming": {
          "type": "boolean",
          "default": true,
          "description": "Enable streaming responses for real-time chat"
        },
        "go-on.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable response caching"
        },
        "go-on.vector.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable vector memory for context"
        },
        "go-on.health.interval": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "maximum": 3600,
          "description": "Health check interval in seconds"
        },
        "go-on.ui.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark",
            "dracula",
            "nord",
            "solarized"
          ],
          "enumDescriptions": [
            "Follow VS Code theme",
            "Light theme",
            "Dark theme",
            "Dracula theme",
            "Nord theme",
            "Solarized theme"
          ],
          "description": "UI theme for the extension"
        },
        "go-on.ui.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 8,
          "maximum": 24,
          "description": "Font size for chat interface"
        },
        "go-on.advancedAI.context": {
          "type": "string",
          "default": "You are a senior engineer assistant with expertise across languages, security, testing, and performance.",
          "description": "Base system prompt used by advanced AI editing commands"
        },
        "go-on.advancedAI.showDiffByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Default behavior to show diff view after advanced edits or refactoring"
        },
        "go-on.language": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "zh_CN",
            "zh_TW"
          ],
          "enumDescriptions": [
            "English",
            "Simplified Chinese",
            "Traditional Chinese"
          ],
          "description": "Language used for the Go-On runtime interface"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx tsc -p ./ && node ./scripts/sync-locales.js",
    "watch": "npx tsc --watch -p ./",
    "watch:locales": "npx tsc --watch -p ./ & nodemon --watch src/locales --ext json -x 'cp -r src/locales/. out/locales'",
    "lint": "eslint src --ext ts",
    "check": "npm run compile && npm run lint",
    "test:contract": "node ./scripts/contract-smoke.js",
    "test": "npm run compile && npm run test:contract"
  },
