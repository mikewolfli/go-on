{
  "name": "go-on-vscode",
  "displayName": "Go-On VS Code Extension",
  "description": "VS Code extension for the Go-On Rust ACP proxy",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:go-on.chat",
    "onCommand:go-on.start",
    "onCommand:go-on.stop",
    "onCommand:go-on.status",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikewolfli/go-on"
  },
  "contributes": {
    "commands": [
      {
        "command": "go-on.start",
        "title": "Start Go-On Proxy"
      },
      {
        "command": "go-on.stop",
        "title": "Stop Go-On Proxy"
      },
      {
        "command": "go-on.sendRequest",
        "title": "Send Chat Request to Go-On"
      },
      {
        "command": "go-on.healthCheck",
        "title": "Check Go-On Health"
      },
      {
        "command": "go-on.healthProbes",
        "title": "Check Go-On Health Probes",
        "icon": "$(heartbeat)"
      },
      {
        "command": "go-on.diagnose",
