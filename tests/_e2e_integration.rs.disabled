//! E2E Integration Tests — CapabilityBus + HarnessBus + 21 F-GAP Modules
//!
//! Validates the full closed-loop flow through all major subsystems:
//!
//!   1. HarnessBus policy evaluation (compliance gate)
//!   2. CapabilityBus sense -> decide -> act -> feedback -> evolve lifecycle
//!   3. WorkflowRegistry matching for task routing
//!   4. Orchestration flow through 14 sub-buses
//!   5. Governance status reporting (BLUE35 S1-S17)
//!   6. Release readiness reporting
//!   7. End-to-end RPC calls through all protocol modes
//!   8. TCP socket-based HTTP JSON-RPC health, governance, chat, workflow, and lifecycle tests
//!
//! This file provides two test strategies:
//!   - **Stdio-based RpcHarness** (shared with acp_runtime_rpc_integration): spawns the binary
//!     and communicates over stdin/stdout with JSON-RPC 2.0.
//!   - **TCP-based HTTP JSON-RPC**: spawns the binary with `--acp-http-bind`, communicates
//!     over raw TCP sockets with HTTP-wrapped JSON-RPC requests.
//!
//! Both use CrossProcessLock and in-process Mutex for test isolation.

use std::fs;
use std::io::{BufRead, BufReader, Read, Write};
use std::path::{Path, PathBuf};
use std::process::{Child, Command, Stdio};
use std::sync::mpsc::{self, Receiver};
use std::sync::{Arc, Mutex, MutexGuard, OnceLock};
use std::thread;
use std::time::{Duration, Instant};

use fs2::FileExt;
use serde_json::{json, Value};
use tempfile::tempdir;

// ---------------------------------------------------------------------------
// Cross-process and in-process locks (mirror acp_runtime_rpc_integration)
// ---------------------------------------------------------------------------

struct CrossProcessLock {
    _file: std::fs::File,
}

impl CrossProcessLock {
    fn lock(path: &Path) -> Self {
        let file = std::fs::OpenOptions::new()
            .create(true)
            .read(true)
            .write(true)
            .open(path)
            .expect("failed to open/create cross-process lock file");
        file.lock_exclusive()
            .expect("failed to acquire cross-process lock");
        Self { _file: file }
    }
}

fn cross_process_lock_path() -> PathBuf {
    std::env::temp_dir().join(".go-on-integration-suite.lock")
}

// ---------------------------------------------------------------------------
// Test Harness -- RpcHarness (same pattern as acp_runtime_rpc_integration)
// ---------------------------------------------------------------------------

struct RpcHarness {
    child: Child,
    stdin: Option<ChildStdin>,
    stdout_rx: Receiver<Value>,
    stderr_lines: Arc<Mutex<Vec<String>>>,
    _suite_guard: MutexGuard<'static, ()>,
    _cross_process_lock: CrossProcessLock,
}

static E2E_SUITE_GUARD: OnceLock<Mutex<()>> = OnceLock::new();

fn suite_guard() -> &'static Mutex<()> {
    E2E_SUITE_GUARD.get_or_init(|| Mutex::new(()))
}

impl RpcHarness {
    fn spawn(config_path: &Path) -> Self {
        let _suite_guard = match suite_guard().lock() {
            Ok(guard) => guard,
            Err(poisoned) => poisoned.into_inner(),
        };
        let lock_path = cross_process_lock_path();
        let _cross_process_lock = CrossProcessLock::lock(&lock_path);

        let mut child = Command::new(binary_path())
            .arg("--config")
            .arg(config_path)
            .env("GO_ON_ENABLE_LOCAL_TEST_AGENTS", "1")
            .stdin(Stdio::piped())
            .stdout(Stdio::piped())
            .stderr(Stdio::piped())
            .spawn()
            .expect("failed to spawn go-on");

        let stdin = child.stdin.take().expect("failed to capture child stdin");
        let stdout = child.stdout.take().expect("failed to capture child stdout");
        let stderr = child.stderr.take().expect("failed to capture child stderr");
        let stderr_lines = Arc::new(Mutex::new(Vec::new()));

        let (stdout_tx, stdout_rx) = mpsc::channel();

        thread::spawn(move || {
            let reader = BufReader::new(stdout);
            for line in reader.lines() {
                let Ok(line) = line else {
                    break;
                };
                if line.trim().is_empty() {
                    continue;
                }
                if let Ok(value) = serde_json::from_str::<Value>(&line) {
                    let _ = stdout_tx.send(value);
                }
            }
        });

        let stderr_lines_clone = Arc::clone(&stderr_lines);
        thread::spawn(move || {
            let reader = BufReader::new(stderr);
            for line in reader.lines() {
                let Ok(line) = line else {
                    break;
                };
                if let Ok(mut guard) = stderr_lines_clone.lock() {
                    guard.push(line);
                    if guard.len() > 200 {
                        let overflow = guard.len() - 200;
                        guard.drain(0..overflow);
                    }
                }
            }
        });

        Self {
            child,
            stdin: Some(stdin),
            stdout_rx,
            stderr_lines,
            _suite_guard,
            _cross_process_lock,
        }
    }

    fn request(&mut self, id: u64, method: &str, params: Option<Value>) -> Value {
        let mut payload = json!({
            "jsonrpc": "2.0",
            "id": id,
            "method": method,
        });
        if let Some(params) = params {
            payload["params"] = params;
        }
        let body = serde_json::to_string(&payload).expect("failed to encode request");
        let stdin = self.stdin.as_mut().expect("stdin already closed");
        writeln!(stdin, "{body}").expect("failed to write request to stdin");
        stdin.flush().expect("failed to flush request");
        self.read_response_for_id(id, Duration::from_secs(10))
    }

    fn close_stdin(&mut self) {
        drop(self.stdin.take());
    }

    fn read_response_for_id(&mut self, id: u64, timeout: Duration) -> Value {
        let deadline = Instant::now() + timeout;
        loop {
            let now = Instant::now();
            if now >= deadline {
                panic!("timed out waiting for response id {id}");
            }
            let remaining = deadline.saturating_duration_since(now);
            let msg = match self.stdout_rx.recv_timeout(remaining) {
                Ok(msg) => msg,
                Err(err) => {
                    let status = self.child.try_wait().ok().flatten();
                    let stderr_tail = self.stderr_tail(30);
                    panic!(
                        "stdout closed while waiting for response id {id}: {err}; child status: {:?}; stderr tail:\n{}",
                        status, stderr_tail
                    );
                }
            };
            if msg.get("id") == Some(&json!(id)) {
                return msg;
            }
        }
    }

    fn wait_for_exit(&mut self, timeout: Duration) {
        self.close_stdin();
        let deadline = Instant::now() + timeout;
        loop {
            match self.child.try_wait() {
                Ok(Some(status)) => {
                    assert!(status.success(), "child exited with status: {status}");
                    return;
                }
                Ok(None) => {
                    if Instant::now() >= deadline {
                        panic!("timed out waiting for child exit");
                    }
                    thread::sleep(Duration::from_millis(20));
                }
                Err(err) => panic!(
                    "failed to wait for child: {err}; stderr tail:\n{}",
                    self.stderr_tail(30)
                ),
            }
        }
    }

    fn stderr_tail(&self, limit: usize) -> String {
        if let Ok(guard) = self.stderr_lines.lock() {
            let start = guard.len().saturating_sub(limit);
            let lines = guard[start..].to_vec();
            if lines.is_empty() {
                "<empty>".to_string()
            } else {
                lines.join("\n")
            }
        } else {
            "<stderr lock poisoned>".to_string()
        }
    }
}

impl Drop for RpcHarness {
    fn drop(&mut self) {
        if let Ok(None) = self.child.try_wait() {
            let _ = self.child.kill();
            let _ = self.child.wait();
        }
    }
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn binary_path() -> PathBuf {
    std::env::var("CARGO_BIN_EXE_go-on")
        .map(PathBuf::from)
        .expect("CARGO_BIN_EXE_go-on is not set")
}

fn write_e2e_config(path: &Path) {
    let config = r#"default_phase = "coding"

[flow]
name = "E2E Integration Flow"
phases = ["coding"]

[runtime]
maintenance_interval_seconds = 30
health_interval_seconds = 45
shutdown_drain_seconds = 7

[agents.local_echo]
type = "local_echo"

[phases.coding]
description = "Coding"
agents = ["local_echo"]
fallback = true

[phases.coding.options.extra]
review_min_level = "standard"
review_required_reviews = 1
review_timeout_policy = "reject"
review_required_checks = []
"#;
    fs::write(path, config).expect("failed to write e2e config file");
}

fn write_e2e_dual_review_config(path: &Path) {
    let config = r#"default_phase = "coding"

[flow]
name = "E2E Dual Review Flow"
phases = ["coding", "review"]

[runtime]
maintenance_interval_seconds = 30
health_interval_seconds = 45
shutdown_drain_seconds = 7

[agents.main_agent]
type = "local_echo"

[agents.reviewer_a]
type = "local_approve"

[agents.reviewer_b]
type = "local_approve"

[phases.coding]
description = "Coding"
agents = ["main_agent"]
fallback = true

[phases.coding.options]
review_timeout_seconds = 2

[phases.coding.options.extra]
review_min_level = "enhanced"
review_required_reviews = 2
review_timeout_policy = "reject"
min_reviewers = 2
required_approvals = 2

[phases.review]
description = "Review"
agents = ["reviewer_a", "reviewer_b"]
fallback = false
"#;
    fs::write(path, config).expect("failed to write e2e dual review config file");
}

fn find_free_port() -> u16 {
    let listener = std::net::TcpListener::bind("127.0.0.1:0").expect("bind ephemeral port");
    let port = listener.local_addr().expect("local addr").port();
    drop(listener);
    port
}

fn http_request(
    addr: &str,
    method: &str,
    path: &str,
    body: Option<&str>,
) -> std::io::Result<String> {
    let mut stream = std::net::TcpStream::connect(addr)?;
    stream.set_read_timeout(Some(Duration::from_secs(5)))?;
    let body = body.unwrap_or("");
    let request = format!(
        "{} {} HTTP/1.1\r\nHost: {}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
        method, path, addr, body.len(), body,
    );
    stream.write_all(request.as_bytes())?;
    let mut response = String::new();
    stream.read_to_string(&mut response)?;
    Ok(response)
}

fn http_json_body(response: &str) -> Value {
    let body = response
        .split_once("\r\n\r\n")
        .map(|(_, b)| b)
        .expect("http response body should exist");
    serde_json::from_str(body).expect("http response body should be json")
}

fn assert_blue22_execution_cycle_shape(result: &Value) {
    assert!(result["capability_profile"].is_object());
    assert!(result["capability_profile"]["platform_mode"].is_string());
    assert!(result["capability_profile"]["phase_compat"].is_object());
    assert!(result["governance_profile"].is_object());
    assert!(result["governance_profile"]["risk_band"].is_string());
    assert!(result["governance_profile"]["budget"].is_object());
    assert!(result["learning_profile"].is_object());
    assert!(result["learning_profile"]["learning_mode"].is_string());
    assert!(result["learning_profile"]["cognition"].is_object());
    assert!(result["token_economy"].is_object());
    assert!(result["token_economy"]["budget"]["request_token_budget"].is_number());
    assert!(result["token_economy"]["multi_round_strategy"]["enabled"].is_boolean());
    assert!(result["token_economy"]["multi_round_strategy"]["max_rounds"].is_number());
    assert!(result["knowledge_refinement"].is_object());
    assert!(result["knowledge_refinement"]["distillation"]["enabled"].is_boolean());
    assert!(result["knowledge_refinement"]["self_evolution"]["mode"].is_string());
    assert!(result["sandbox_profile"].is_object());
    assert!(result["sandbox_profile"]["selected"].is_string());
    assert!(result["approval_checkpoint"].is_object());
    assert!(result["approval_checkpoint"]["required"].is_boolean());
    assert!(result["approval_checkpoint"]["resume_token"].is_string());
    assert!(result["repo_context"].is_object());
    assert!(result["repo_context"]["repository"].is_string());
    assert!(result["repo_context"]["patch_set"]["count"].is_number());
    assert!(result["execution_cycle"].is_object());
    assert!(result["execution_cycle"]["cycle_id"].is_string());
    assert!(result["execution_cycle"]["current_cycle"].is_object());
    assert!(result["execution_cycle"]["cycles"].is_array());
    assert!(result["execution_cycle"]["history_summary"]["total_cycles"].is_number());
    assert!(result["execution_cycle"]["history_summary"]["pending_repair_iterations"].is_number());
    assert!(result["execution_cycle"]["auto_repair"].is_object());
    assert!(result["execution_cycle"]["current_cycle"]["plan_version"].is_string());
}

// ===========================================================================
// E2E TEST 1: HarnessBus policy evaluation lifecycle
// ===========================================================================

#[test]
fn e2e_harness_bus_policy_evaluation_lifecycle() {
    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_config(&config_path);

    let mut harness = RpcHarness::spawn(&config_path);

    let init = harness.request(1, "initialize", None);
    assert_eq!(init["result"]["name"], "go-on");
    assert_eq!(init["result"]["protocol"], "acp");

    let gov = harness.request(2, "governance.status", None);
    assert!(
        gov["result"]["governance"].is_object(),
        "governance.status must return governance object"
    );

    let gov_obj = &gov["result"]["governance"];

    assert!(
        gov_obj["pua_governance_profile"].is_object(),
        "governance must include pua_governance_profile"
    );
    assert!(
        gov_obj["pua_governance_profile"]["total_evaluations"].is_number(),
        "pua_governance_profile must have total_evaluations"
    );

    assert!(
        gov_obj["drift_protection_profile"].is_object(),
        "governance must include drift_protection_profile (F-GAP-26)"
    );
    assert!(
        gov_obj["drift_protection_profile"]["drift_events"].is_number(),
        "drift_protection_profile must include drift_events"
    );

    assert!(
        gov_obj["hyper_resilience_profile"].is_object(),
        "governance must include hyper_resilience_profile (F-GAP-27)"
    );
    assert!(
        gov_obj["hyper_resilience_profile"]["circuit_breaker_trips"].is_number(),
        "hyper_resilience_profile must include circuit_breaker_trips"
    );

    assert!(
        gov_obj["fault_tolerance_profile"].is_object(),
        "governance must include fault_tolerance_profile (F-GAP-28)"
    );
    assert!(
        gov_obj["fault_tolerance_profile"]["heartbeat_timeouts"].is_number(),
        "fault_tolerance_profile must include heartbeat_timeouts"
    );

    assert!(
        gov_obj["brain_loop_profile"].is_object(),
        "governance must include brain_loop_profile"
    );
    assert!(
        gov_obj["brain_loop_profile"]["loop_count"].is_number(),
        "brain_loop_profile must have loop_count"
    );

    let execute = harness.request(
        3,
        "task.execute",
        Some(json!({
            "task": "Refactor authentication module with security hardening",
            "requirement_confirmed": true,
            "requirement_contract": {
                "goal": "Harden auth module",
                "scope": "auth",
                "acceptance_criteria": ["all tests pass"],
                "constraints": ["no breaking API changes"],
                "user_confirmed": true
            }
        })),
    );
    assert_eq!(execute["result"]["ok"], true, "task.execute must succeed");

    let gov2 = harness.request(4, "governance.status", None);
    let pua = &gov2["result"]["governance"]["pua_governance_profile"];
    let total_evals = pua["total_evaluations"].as_u64().unwrap_or(0);
    assert!(
        total_evals >= 1,
        "pua_governance_profile.total_evaluations should be >= 1 after task.execute, got {total_evals}"
    );

    let shutdown = harness.request(5, "shutdown", None);
    assert_eq!(shutdown["result"]["ok"], true);
    harness.wait_for_exit(Duration::from_secs(8));
}

// ===========================================================================
// E2E TEST 2: CapabilityBus full lifecycle cycle
// ===========================================================================

#[test]
fn e2e_capability_bus_full_lifecycle_cycle() {
    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_config(&config_path);

    let mut harness = RpcHarness::spawn(&config_path);

    let init = harness.request(10, "initialize", None);
    assert_eq!(init["result"]["name"], "go-on");

    let execute = harness.request(
        11,
        "task.execute",
        Some(json!({
            "task": "Implement user login feature with OAuth2 support",
            "requirement_confirmed": true,
            "requirement_contract": {
                "goal": "Add OAuth2 login capability",
                "scope": "auth module",
                "acceptance_criteria": ["user can log in via OAuth2"],
                "constraints": ["must support refresh tokens"],
                "user_confirmed": true
            }
        })),
    );
    assert_eq!(execute["result"]["ok"], true, "task.execute must succeed");
    assert_blue22_execution_cycle_shape(&execute["result"]);

    let ec = &execute["result"]["execution_cycle"];
    assert!(
        ec["task_graph_checkpoint"].is_object(),
        "execution_cycle.task_graph_checkpoint must be object (B26-S11)"
    );
    assert!(ec["task_graph_checkpoint"]["checkpoint_id"].is_string());
    assert!(ec["task_graph_checkpoint"]["resume_eligible"].is_boolean());

    assert!(
        ec["tool_loop"].is_object(),
        "execution_cycle.tool_loop must be object (B26-S12)"
    );
    assert!(ec["tool_loop"]["phase"].is_string());
    assert!(ec["tool_loop"]["safety_gate_passed"].is_boolean());
    assert!(ec["tool_loop"]["governance"].is_object());

    assert!(execute["result"]["learning_profile"].is_object());
    assert!(execute["result"]["learning_profile"]["learning_mode"].is_string());

    assert!(execute["result"]["knowledge_refinement"].is_object());
    assert!(execute["result"]["knowledge_refinement"]["distillation"]["enabled"].is_boolean());

    let shutdown = harness.request(12, "shutdown", None);
    assert_eq!(shutdown["result"]["ok"], true);
    harness.wait_for_exit(Duration::from_secs(8));
}

// ===========================================================================
// E2E TEST 3: WorkflowRegistry matching and execution
// ===========================================================================

#[test]
fn e2e_workflow_registry_matching_and_execution() {
    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_config(&config_path);

    let mut harness = RpcHarness::spawn(&config_path);

    let init = harness.request(20, "initialize", None);
    assert_eq!(init["result"]["name"], "go-on");

    let gov = harness.request(21, "governance.status", None);
    let wf_profile = &gov["result"]["governance"]["workflow_type_tri_mode"]["workflow_profile"];
    assert!(wf_profile["configured_workflow_type"].is_string());
    assert!(wf_profile["effective_workflow_type"].is_string());

    let task = "Refactor auth and billing modules with security hardening";
    let confirmed = harness.request(
        22,
        "workflow.confirm",
        Some(json!({
            "task": task,
            "user_confirmed": true,
            "ready_to_confirm": true,
            "requirement_contract": {
                "goal": "Harden release path",
                "scope": "auth and billing modules",
                "non_goals": ["rewrite architecture"],
                "acceptance_criteria": [
                    "all existing tests pass",
                    "no regression"
                ],
                "constraints": [
                    "no breaking API changes",
                    "must keep migration reversible"
                ]
            }
        })),
    );
    assert_eq!(
        confirmed["result"]["ok"], true,
        "workflow.confirm must succeed"
    );

    let execute = harness.request(
        23,
        "workflow.execute",
        Some(json!({
            "task": task,
            "requirement_confirmed": true,
            "capability_decision": "degrade",
            "capability_confirm": true,
            "clarification_rounds": 3,
            "clarification_quality_score": 0.85,
            "requirement_change_count": 2,
            "auto_gates": false
        })),
    );
    assert_eq!(
        execute["result"]["ok"], true,
        "workflow.execute must succeed"
    );

    let rp = &execute["result"]["review_policy"];
    assert!(rp.is_object(), "review_policy must be object");
    assert_eq!(rp["min_review_level"], "standard");
    assert_eq!(rp["required_reviews"], 1);

    assert!(execute["result"]["artifacts"].is_object());
    assert!(execute["result"]["trace_ref"].is_object());
    assert!(execute["result"]["gates"].is_object());

    let learning_path = execute["result"]["learning_artifact_path"]
        .as_str()
        .expect("learning_artifact_path must be string");
    let learning_raw = fs::read_to_string(learning_path).expect("failed to read learning artifact");
    let learning_json: Value =
        serde_json::from_str(&learning_raw).expect("learning artifact must be valid json");
    assert!(learning_json["events"].is_array());
    let events = learning_json["events"].as_array().unwrap();
    let last_event = events
        .last()
        .expect("must have at least one learning event");
    assert_eq!(last_event["clarification_rounds"], 3);
    assert_eq!(last_event["requirement_change_count"], 2);

    let shutdown = harness.request(24, "shutdown", None);
    assert_eq!(shutdown["result"]["ok"], true);
    harness.wait_for_exit(Duration::from_secs(8));
}

// ===========================================================================
// E2E TEST 4: Orchestration sub-buses governance profiles (BLUE35 S1-S15)
// ===========================================================================

#[test]
fn e2e_orchestration_all_sub_buses_governance_and_readiness() {
    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_config(&config_path);

    let mut harness = RpcHarness::spawn(&config_path);

    harness.request(30, "initialize", None);

    let gov = harness.request(31, "governance.status", None);
    let g = &gov["result"]["governance"];

    assert!(g["custom_role_registry"].is_object(), "S1 missing");
    assert!(g["custom_role_registry"]["ready"].is_boolean());

    assert!(g["custom_role_dynamic_matching"].is_object(), "S2 missing");

    assert!(g["compliance_audit_metadata"].is_object(), "S3 missing");
    assert!(g["compliance_audit_metadata"]["compliance_framework_profile"].is_object());

    assert!(g["self_rationalization_guard"].is_object(), "S4 missing");
    assert!(g["self_rationalization_guard"]["self_rationalization_guard_profile"].is_object());

    assert!(g["startup_context_loader"].is_object(), "S5 missing");
    assert!(g["startup_context_loader"]["enabled"].is_boolean());

    assert!(g["layered_prompt_builder"].is_object(), "S6 missing");
    assert!(g["layered_prompt_builder"]["prompt_layer_profile"].is_object());

    assert!(g["layered_token_trigger"].is_object(), "S7 missing");
    assert!(g["layered_token_trigger"]["layered_token_trigger_profile"].is_object());

    assert!(g["multi_priority_scheduler"].is_object(), "S8 missing");
    assert!(g["multi_priority_scheduler"]["dual_level_scheduler_profile"].is_object());

    assert!(g["worker_scheduler_backpressure"].is_object(), "S9 missing");
    assert!(g["worker_scheduler_backpressure"]["priority_queue_profile"].is_object());

    assert!(g["fork_isolation_guard"].is_object(), "S10 missing");
    assert!(g["fork_isolation_guard"]["fork_isolation_profile"].is_object());

    assert!(g["capability_graph"].is_object(), "S11 missing");
    assert!(g["capability_graph"]["capability_graph_profile"].is_object());

    assert!(g["provenance_ledger"].is_object(), "S12 missing");
    assert!(g["provenance_ledger"]["provenance_ledger_profile"].is_object());

    assert!(g["node_reputation_tracker"].is_object(), "S13 missing");
    assert!(g["node_reputation_tracker"]["node_reputation_profile"].is_object());

    assert!(g["k8s_delivery_pack"].is_object(), "S14 missing");
    assert!(g["k8s_delivery_pack"]["cloud_native_profile"].is_object());

    assert!(g["sdk_multi_l"].is_object(), "S15 missing");

    let shutdown = harness.request(32, "shutdown", None);
    assert_eq!(shutdown["result"]["ok"], true);
    harness.wait_for_exit(Duration::from_secs(8));
}

// ===========================================================================
// TCP-based HTTP JSON-RPC E2E Tests
// ===========================================================================
//
// These tests spawn the go-on binary as an HTTP server (using --acp-http-bind)
// and communicate over raw TCP sockets with HTTP-wrapped JSON-RPC requests.
// This validates the HTTP server transport layer end-to-end.

/// Write a minimal HTTP-server test config.
fn write_e2e_http_config(path: &Path) {
    let config = r##"default_phase = "coding"

[flow]
name = "E2E HTTP Integration Flow"
phases = ["coding"]

[runtime]
maintenance_interval_seconds = 60
health_interval_seconds = 90
shutdown_drain_seconds = 10

[agents.local_echo]
type = "local_echo"

[phases.coding]
description = "Coding"
agents = ["local_echo"]
fallback = true

[phases.coding.options.extra]
review_min_level = "standard"
review_required_reviews = 1
review_timeout_policy = "reject"
review_required_checks = []
"##;
    fs::write(path, config).expect("failed to write e2e http config file");
}

fn start_http_server(config_path: &Path) -> (Child, u16) {
    let port = find_free_port();
    let bind_addr = format!("127.0.0.1:{}", port);

    let child = Command::new(binary_path())
        .arg("--config")
        .arg(config_path)
        .arg("--acp-http-bind")
        .arg(&bind_addr)
        .env("GO_ON_ENABLE_LOCAL_TEST_AGENTS", "1")
        .stdin(Stdio::null())
        .stdout(Stdio::null())
        .stderr(Stdio::null())
        .spawn()
        .expect("failed to spawn go-on HTTP server");

    wait_for_tcp_port(port, Duration::from_secs(30));

    (child, port)
}

fn wait_for_tcp_port(port: u16, timeout: Duration) {
    let start = Instant::now();
    while start.elapsed() < timeout {
        if std::net::TcpStream::connect_timeout(
            &format!("127.0.0.1:{}", port)
                .parse()
                .expect("invalid socket address"),
            Duration::from_secs(1),
        )
        .is_ok()
        {
            thread::sleep(Duration::from_millis(200));
            return;
        }
        thread::sleep(Duration::from_millis(100));
    }
    panic!(
        "Server failed to start on port {} within {:?}",
        port, timeout
    );
}

fn http_jsonrpc_request(port: u16, method: &str, params: &Value) -> Value {
    let request_body = serde_json::to_string(&json!({
        "jsonrpc": "2.0",
        "id": 1,
        "method": method,
        "params": params
    }))
    .expect("failed to serialize request");

    let http_request = format!(
        "POST / HTTP/1.1\r\n\
         Host: 127.0.0.1:{}\r\n\
         Content-Type: application/json\r\n\
         Content-Length: {}\r\n\
         Connection: close\r\n\
         \r\n\
         {}",
        port,
        request_body.len(),
        request_body
    );

    let mut stream = std::net::TcpStream::connect(format!("127.0.0.1:{}", port))
        .expect("failed to connect to server");
    stream
        .set_read_timeout(Some(Duration::from_secs(10)))
        .expect("set timeout");
    stream
        .write_all(http_request.as_bytes())
        .expect("failed to write request");
    stream.flush().expect("flush");

    let mut response = Vec::new();
    let mut buf = [0u8; 4096];
    loop {
        match stream.read(&mut buf) {
            Ok(0) => break,
            Ok(n) => response.extend_from_slice(&buf[..n]),
            Err(_) => break,
        }
    }

    let response_str = String::from_utf8_lossy(&response);
    let body = response_str.split("\r\n\r\n").nth(1).unwrap_or("").trim();

    if body.is_empty() {
        let body = response_str.split("\n\n").nth(1).unwrap_or("").trim();
        serde_json::from_str(body).unwrap_or_else(|e| {
            panic!(
                "failed to parse JSON-RPC body: {}; raw: {}",
                e, response_str
            )
        })
    } else {
        serde_json::from_str(body).unwrap_or_else(|e| {
            panic!(
                "failed to parse JSON-RPC body: {}; raw: {}",
                e, response_str
            )
        })
    }
}

// ── TCP E2E Test 1: Health Check ─────────────────────────────────────────

#[test]
fn e2e_tcp_health_check() {
    let _guard = match suite_guard().lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    let lock_path = cross_process_lock_path();
    let _cross_process_lock = CrossProcessLock::lock(&lock_path);

    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_http_config(&config_path);

    let (mut child, port) = start_http_server(&config_path);

    let response = http_jsonrpc_request(port, "initialize", &json!({}));
    assert_eq!(response.get("jsonrpc"), Some(&json!("2.0")));
    assert!(
        response.get("result").is_some(),
        "initialize must return a result"
    );
    let result = response["result"]
        .as_object()
        .expect("result must be object");
    assert_eq!(result.get("name"), Some(&json!("go-on")));
    assert_eq!(result.get("protocol"), Some(&json!("acp")));

    let health = http_jsonrpc_request(port, "runtime.health", &json!({}));
    let hr = health["result"]
        .as_object()
        .expect("health result must be object");
    assert!(
        hr.contains_key("lifecycle"),
        "health must contain lifecycle"
    );
    assert!(
        hr.contains_key("maintenance"),
        "health must contain maintenance"
    );

    let shutdown = http_jsonrpc_request(port, "shutdown", &json!({}));
    assert_eq!(shutdown["result"]["ok"], json!(true));

    child.kill().ok();
    child.wait().ok();
}

// ── TCP E2E Test 2: Governance Status ────────────────────────────────────

#[test]
fn e2e_tcp_governance_status() {
    let _guard = match suite_guard().lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    let lock_path = cross_process_lock_path();
    let _cross_process_lock = CrossProcessLock::lock(&lock_path);

    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_http_config(&config_path);

    let (mut child, port) = start_http_server(&config_path);

    http_jsonrpc_request(port, "initialize", &json!({}));

    let response = http_jsonrpc_request(port, "governance.status", &json!({}));
    let result = response["result"].as_object().expect("must return object");
    assert!(result.contains_key("governance"), "must contain governance");
    let governance = &result["governance"];
    assert!(
        governance.get("pua_governance_profile").is_some()
            || governance.get("drift_protection_profile").is_some(),
        "governance must contain at least one expected profile"
    );

    http_jsonrpc_request(port, "shutdown", &json!({}));
    child.kill().ok();
    child.wait().ok();
}

// ── TCP E2E Test 3: Chat Completion Flow ─────────────────────────────────

#[test]
fn e2e_tcp_chat_completion_flow() {
    let _guard = match suite_guard().lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    let lock_path = cross_process_lock_path();
    let _cross_process_lock = CrossProcessLock::lock(&lock_path);

    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_http_config(&config_path);

    let (mut child, port) = start_http_server(&config_path);

    http_jsonrpc_request(port, "initialize", &json!({}));

    let response = http_jsonrpc_request(
        port,
        "chat.completions",
        &json!({
            "model": "test-model",
            "messages": [{"role": "user", "content": "Hello"}],
            "max_tokens": 50
        }),
    );

    assert!(
        response.get("result").is_some() || response.get("error").is_some(),
        "chat.completions should return result or error"
    );

    http_jsonrpc_request(port, "shutdown", &json!({}));
    child.kill().ok();
    child.wait().ok();
}

// ── TCP E2E Test 4: Workflow Execution ───────────────────────────────────

#[test]
fn e2e_tcp_workflow_execution() {
    let _guard = match suite_guard().lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    let lock_path = cross_process_lock_path();
    let _cross_process_lock = CrossProcessLock::lock(&lock_path);

    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_http_config(&config_path);

    let (mut child, port) = start_http_server(&config_path);

    http_jsonrpc_request(port, "initialize", &json!({}));

    let confirm = http_jsonrpc_request(
        port,
        "workflow.confirm",
        &json!({
            "task": "End-to-end test task",
            "user_confirmed": true,
            "ready_to_confirm": true,
            "requirement_contract": {
                "goal": "Test workflow execution over HTTP",
                "scope": "e2e tests",
                "acceptance_criteria": ["returns valid result"],
                "constraints": []
            }
        }),
    );
    assert!(
        confirm.get("result").is_some(),
        "workflow.confirm should return result"
    );

    let execute = http_jsonrpc_request(
        port,
        "workflow.execute",
        &json!({
            "workflow_id": "e2e-http-test",
            "task": "End-to-end test task",
            "requirement_confirmed": true,
            "capability_decision": "proceed",
            "capability_confirm": true,
            "steps": [{"id": "step1", "type": "task", "input": "e2e over http"}]
        }),
    );

    assert!(
        execute.get("result").is_some() || execute.get("error").is_some(),
        "workflow.execute should return result or error"
    );

    if let Some(result) = execute.get("result") {
        if let Some(repair) = result.get("repair_readiness") {
            assert!(repair.get("eligible").is_some());
        }
    }

    http_jsonrpc_request(port, "shutdown", &json!({}));
    child.kill().ok();
    child.wait().ok();
}

// ── TCP E2E Test 5: Multi-protocol Consistency ───────────────────────────

#[test]
fn e2e_tcp_protocol_consistency() {
    let _guard = match suite_guard().lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    let lock_path = cross_process_lock_path();
    let _cross_process_lock = CrossProcessLock::lock(&lock_path);

    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_http_config(&config_path);

    let (mut child, port) = start_http_server(&config_path);

    let acp = http_jsonrpc_request(
        port,
        "initialize",
        &json!({"protocol": "acp", "version": "1.0"}),
    );
    assert!(acp.get("result").is_some());
    let acp_result = &acp["result"];
    assert!(acp_result.get("protocol").is_some() || acp_result.get("name").is_some());

    let gov = http_jsonrpc_request(port, "governance.status", &json!({}));
    assert!(gov.get("result").is_some());

    let caps = http_jsonrpc_request(port, "capabilities.list", &json!({}));
    assert!(caps.get("result").is_some());

    http_jsonrpc_request(port, "shutdown", &json!({}));
    child.kill().ok();
    child.wait().ok();
}

// ── TCP E2E Test 6: Full Lifecycle ───────────────────────────────────────

#[test]
fn e2e_tcp_full_lifecycle() {
    let _guard = match suite_guard().lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    let lock_path = cross_process_lock_path();
    let _cross_process_lock = CrossProcessLock::lock(&lock_path);

    let temp = tempdir().expect("failed to create temp dir");
    let config_path = temp.path().join("config.toml");
    write_e2e_http_config(&config_path);

    let (mut child, port) = start_http_server(&config_path);

    // Step 1: health
    let health = http_jsonrpc_request(port, "runtime.health", &json!({}));
    assert!(health.get("result").is_some());

    // Step 2: initialize
    let init = http_jsonrpc_request(port, "initialize", &json!({}));
    assert!(init.get("result").is_some());

    // Step 3: capabilities
    let caps = http_jsonrpc_request(port, "capabilities.list", &json!({}));
    assert!(caps.get("result").is_some());

    // Step 4: governance
    let gov = http_jsonrpc_request(port, "governance.status", &json!({}));
    assert!(gov.get("result").is_some());

    // Step 5: workflow confirm
    let confirm = http_jsonrpc_request(
        port,
        "workflow.confirm",
        &json!({
            "task": "Lifecycle E2E test",
            "user_confirmed": true,
            "ready_to_confirm": true,
            "requirement_contract": {
                "goal": "Validate full lifecycle",
                "scope": "full lifecycle",
                "acceptance_criteria": ["completes without error"],
                "constraints": []
            }
        }),
    );
    assert!(
        confirm.get("result").is_some(),
        "workflow.confirm should succeed"
    );

    // Step 6: workflow execute
    let wf = http_jsonrpc_request(
        port,
        "workflow.execute",
        &json!({
            "workflow_id": "lifecycle-http-test",
            "task": "Lifecycle E2E test",
            "requirement_confirmed": true,
            "capability_decision": "proceed",
            "capability_confirm": true,
            "steps": [{"id": "s1", "type": "task", "input": "full lifecycle test"}]
        }),
    );
    assert!(
        wf.get("result").is_some() || wf.get("error").is_some(),
        "workflow execution should complete"
    );

    // Shutdown
    let shutdown = http_jsonrpc_request(port, "shutdown", &json!({}));
    assert_eq!(
        shutdown["result"]["ok"],
        json!(true),
        "shutdown must return ok: true"
    );

    child.kill().ok();
    child.wait().ok();
}
