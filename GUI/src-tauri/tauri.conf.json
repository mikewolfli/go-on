{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "go-on GUI",
  "version": "0.9.1",
  "identifier": "com.goon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "go-on GUI",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true
      },
      {
        "label": "mini",
        "title": "go-on Mini Console",
        "width": 360,
        "height": 240,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "url": "#/mini"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8090"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
