{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability",
  "windows": ["main", "mini"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "core:app:default",
    "shell:allow-execute",
    "shell:allow-open",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size"
  ]
}
