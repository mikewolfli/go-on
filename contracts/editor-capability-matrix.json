  "protocolErrorContract": {
    "_comment": "JSON-RPC error code semantics shared across ACP stdio + MCP stdio/http. ACP HTTP uses HTTP status codes.",
    "_version": "blue18-batch-c",
    "jsonRpcCodes": {
      "-32700": {
        "name": "PARSE_ERROR",
        "meaning": "Malformed JSON input"
      },
      "-32600": {
        "name": "INVALID_REQUEST",
        "meaning": "Not a valid JSON-RPC request object"
      },
      "-32601": {
        "name": "METHOD_NOT_FOUND",
        "meaning": "Unknown or unsupported method for this mode"
      },
      "-32602": {
        "name": "INVALID_PARAMS",
        "meaning": "Invalid or missing method parameters"
      },
      "-32603": {
        "name": "INTERNAL_ERROR",
        "meaning": "Unhandled server-side error"
      }
    },
    "acpExtensions": {
      "NOT_IMPLEMENTED_EXECUTOR": {
        "field": "code",
        "meaning": "Skill imported but no executor registered; executed=false"
      }
    },
    "crossModeConsistency": {
      "unknownMethod": {
        "acp_stdio": -32601,
        "mcp_stdio": -32601,
        "mcp_http": -32601
      },
      "missingParams": {
        "acp_stdio": -32602,
        "mcp_stdio": -32602,
        "mcp_http": -32602
      },
      "internalError": {
        "acp_stdio": -32603,
        "mcp_stdio": -32603,
        "mcp_http": -32603
      }
    }
  }
